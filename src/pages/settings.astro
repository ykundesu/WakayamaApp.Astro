---
import Base from "@/layouts/Base.astro";
import {prerender} from "@/platform/render";
import Screen from "@/screens/settings";
const {html,css}=prerender(Screen,"settings");
---
<Base title="設定｜和歌山高専 非公式アプリ" html={html} css={css} detail={false}>
<script>requestAnimationFrame(()=>setTimeout(()=>import("@/entries/settings").then(m=>m.start()),0));</script>
</Base>
