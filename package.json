{
  "name": "wakayamaapp-astro",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "web": "astro dev --host 127.0.0.1",
    "build": "node scripts/optimize-icons.mjs && astro build && node scripts/finalize.mjs",
    "export": "npm run build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "check:deploy": "wrangler deploy --dry-run",
    "test:browser": "node scripts/test-browser.mjs",
    "test:ux": "node scripts/test-browser.mjs tests/ux.py"
  },
  "dependencies": {
    "astro": "^7.3.3",
    "dompurify": "^3.2.0",
    "markdown-it": "^14.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native-web": "0.19.13"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-native-web": "^0.19.0",
    "react-native": "^0.76.9",
    "sharp": "^0.35.4",
    "typescript": "^5.9.0",
    "wrangler": "4.136.3"
  },
  "overrides": {
    "image-size": "^2.0.4"
  }
}
