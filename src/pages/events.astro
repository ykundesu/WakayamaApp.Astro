---
import Base from "@/layouts/Base.astro";
import {prerender} from "@/platform/render";
import Screen from "@/screens/events";
const {html,css}=prerender(Screen,"events");
---
<Base title="行事｜和歌山高専 非公式アプリ" html={html} css={css} detail={false}>
<script>requestAnimationFrame(()=>setTimeout(()=>import("@/entries/events").then(m=>m.start()),0));</script>
</Base>
