---
import Base from "@/layouts/Base.astro";
import {prerender} from "@/platform/render";
import Screen from "@/screens/changelog";
const {html,css}=prerender(Screen,"changelog");
---
<Base title="更新履歴｜和歌山高専 非公式アプリ" html={html} css={css} detail={false}>
<script>requestAnimationFrame(()=>setTimeout(()=>import("@/entries/changelog").then(m=>m.start()),0));</script>
</Base>
