---
import Base from "@/layouts/Base.astro";
import {prerender} from "@/platform/render";
import Screen from "@/screens/meals";
const {html,css}=prerender(Screen,"meals");
---
<Base title="寮食｜和歌山高専 非公式アプリ" html={html} css={css} detail={false}>
<script>requestAnimationFrame(()=>setTimeout(()=>import("@/entries/meals").then(m=>m.start()),0));</script>
</Base>
